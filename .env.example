# EmailJS credentials — get these from https://dashboard.emailjs.com
# Replace the placeholder values with your real ones,
# then add them as Environment Variables in your Vercel project settings too.

VITE_EMAILJS_SERVICE_ID=service_xxxxxxx
VITE_EMAILJS_TEMPLATE_ID=template_xxxxxxx
VITE_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxxxxxxxxx
